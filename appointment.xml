<?xml version="1.0" encoding="utf-8"?>
<tryton>
    <data>

        <record model="ir.ui.view" id="view_appointment_tree_copago_services">
            <field name="model">gnuhealth.appointment</field>
            <field name="inherit" ref="health.gnuhealth_appointment_tree"/>
            <field name="name">gnuhealth_appointment_tree_copago_services</field>
            <field name="arch" type="xml"><![CDATA[
                <data>
                    <xpath expr="/tree/field[@name='healthprof']" position="after">
                        <field name="copago_status"/>
                    </xpath>
                </data>
            ]]></field>
        </record>

        <record model="ir.ui.view" id="view_appointment_form_copago_services">
            <field name="model">gnuhealth.appointment</field>
            <field name="inherit" ref="health.gnuhealth_appointment_form"/>
            <field name="name">gnuhealth_appointment_form_copago_services</field>
            <field name="arch" type="xml"><![CDATA[
                <data>
                    <xpath expr="/form/group/field[@name='patient']"
                        position="after">
                        <label name="copago_status"/>
                        <field name="copago_status"/>
                    </xpath>
                </data>
            ]]></field>
        </record>

    </data>
</tryton>
